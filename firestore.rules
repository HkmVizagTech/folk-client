rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    // Admin or Folks Head (staff)
    function isStaff() {
      return role() in ['admin', 'folks_head'];
    }

    function isSuperAdmin() {
      return role() == 'admin';
    }

    // Profile fields only the team sets (FOLK guide assignment, journey
    // stage, follow-up bookkeeping). `level` is the older name for stage.
    function staffManagedFields() {
      return ['stage', 'level', 'guideId', 'guideName', 'guidePhone',
              'nextFollowUpDate', 'lastFollowUpAt', 'lastFollowUpNote'];
    }

    // The one hardcoded root account. This is a real Firebase Auth UID, so it
    // can never be spoofed by another signed-in user - only the person who
    // actually owns that Firebase account can ever satisfy request.auth.uid == this.
    function isRootAdminUid() {
      return request.auth.uid == 'wRbvUaFiBOYeXEEtF8OuXnzGWXs2';
    }

    // ---------------- EVENTS ----------------
    // Publicly readable so logged-out users can see the events on the landing page.
    // Staff may create/edit freely; any signed-in devotee may RSVP by tweaking
    // ONLY the attending/declined counters (+/-1 per tap), never other fields.
    match /events/{eventId} {
      allow read: if true;
      allow create: if isStaff();
      allow update: if isStaff() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendingCount', 'declinedCount']) &&
        request.resource.data.attendingCount >= 0 &&
        request.resource.data.declinedCount >= 0 &&
        (!('attendingCount' in resource.data) || request.resource.data.attendingCount - resource.data.attendingCount in [-1, 0, 1]) &&
        (!('declinedCount' in resource.data) || request.resource.data.declinedCount - resource.data.declinedCount in [-1, 0, 1])
      );
      allow delete: if isSuperAdmin();
    }

    // ---------------- NOTIFICATIONS ----------------
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow update, delete: if isSuperAdmin();
    }

    // ---------------- USERS ----------------
    // Every new account is created as a plain "devotee" - the only exception
    // is the single hardcoded root admin uid, which nobody can spoof (see
    // isRootAdminUid above). Nobody can self-assign folks_head/admin at
    // signup any more; an existing admin has to promote them afterwards
    // through the `update` rule below. This closes the privilege-escalation
    // hole where any signed-up user could set role:"admin" on themselves.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());

      allow create: if isSignedIn() && (
        // Self-registration always starts as a plain devotee, except the
        // one hardcoded (unspoofable) root admin uid.
        (
          request.auth.uid == userId &&
          !request.resource.data.keys().hasAny(staffManagedFields()) &&
          (
            (isRootAdminUid() && request.resource.data.role == 'admin') ||
            (!isRootAdminUid() && request.resource.data.role == 'devotee')
          )
        ) ||
        // Staff manually adding a profile for someone without an account yet
        // (e.g. the "Add Devotee" form) - always created as a plain devotee;
        // an admin can promote them afterwards via the `update` rule below.
        // folks_head cannot hand out admin/folks_head this way either.
        (isStaff() && request.resource.data.role == 'devotee') ||
        // A super admin may create a profile with any role directly.
        isSuperAdmin()
      );

      // Anyone may update their own non-role fields. A folks_head may update
      // the non-role fields (e.g. assignedGroup, phone) of plain devotees
      // only: editing a staff profile's phone would let them sign in to that
      // account through phone OTP. Only an admin may ever change the `role`
      // field itself - folks_head can never promote anyone (including
      // themselves). The root account may promote its own profile.
      // Members can't change the fields the team manages about them (their
      // stage, their FOLK guide, follow-up bookkeeping) on their own profile.
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (request.auth.uid == userId && isRootAdminUid()) ||
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) &&
          (
            (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(staffManagedFields())) ||
            (isStaff() && resource.data.get('role', 'devotee') == 'devotee')
          )
        )
      );

      allow delete: if isSuperAdmin();
    }

    // ---------------- REGISTRATIONS (event RSVPs) ----------------
    // Owners may freely update their own registration (status/token toggle
    // on re-RSVP) but can never repoint it at a different event or user -
    // that would corrupt the manual check-in lookup staff rely on.
    match /registrations/{regId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isStaff());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        isStaff() ||
        (
          request.auth.uid == resource.data.userId &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.eventId == resource.data.eventId
        )
      );
      allow delete: if isSuperAdmin();
    }

    // ---------------- SADHANA LOGS ----------------
    // Content placeholders when the log does not exist yet are safe - there
    // is nothing to leak, and both the Morning Vow transaction and the sadhana
    // query read the doc by id before it has been created (resource == null).
    match /sadhana_logs/{logId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isStaff());
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSuperAdmin();
    }

    // ---------------- ATTENDANCE / PRASADAM LOGS ----------------
    // Only staff create these (they are produced by admin scanners during check-in).
    match /attendance/{attId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isStaff());
      allow create, update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    match /prasadam_logs/{logId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isStaff());
      allow create, update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    // ---------------- ACCOMMODATION REQUESTS ----------------
    // Devotees can submit their own request and read it (staff read all).
    // Status changes (approve/reject/recommend) are NOT done from the client
    // any more - they go through the backend's /updateAccommodationStatus,
    // which enforces "folks_head can only recommend, and only for their own
    // assigned group" and sends the WhatsApp confirmation. The Admin SDK
    // bypasses these rules, so the backend can still write here; no direct
    // client write (by anyone, staff included) is allowed.
    match /accommodation_requests/{reqId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isStaff());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ---------------- SEVAS ----------------
    // Any signed-in devotee may adjust `countRegistered` themselves (this is
    // how join/cancel works client-side), but only by exactly +1 or -1, never
    // below 0 or past maxVolunteers, and only in the same transaction that
    // flips THEIR OWN registration: +1 when it becomes 'registered', -1 when
    // it stops being so. Otherwise anyone could decrement a full seva back
    // open, or inflate it, without registering.
    function sevaRegPath(sevaId) {
      return /databases/$(database)/documents/seva_registrations/$(request.auth.uid + '_' + sevaId);
    }
    function sevaHeldBefore(sevaId) {
      return exists(sevaRegPath(sevaId)) && get(sevaRegPath(sevaId)).data.status == 'registered';
    }
    function sevaHeldAfter(sevaId) {
      return existsAfter(sevaRegPath(sevaId)) && getAfter(sevaRegPath(sevaId)).data.status == 'registered';
    }

    match /sevas/{sevaId} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow update: if isStaff() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['countRegistered']) &&
        request.resource.data.countRegistered >= 0 &&
        (
          (request.resource.data.countRegistered == resource.data.countRegistered + 1 &&
            !sevaHeldBefore(sevaId) && sevaHeldAfter(sevaId)) ||
          (request.resource.data.countRegistered == resource.data.countRegistered - 1 &&
            sevaHeldBefore(sevaId) && !sevaHeldAfter(sevaId))
        ) &&
        (!('maxVolunteers' in resource.data) || request.resource.data.countRegistered <= resource.data.maxVolunteers)
      );
      allow delete: if isSuperAdmin();
    }

    // ---------------- SEVA REGISTRATIONS ----------------
    // Owners can register/cancel themselves, but only staff can ever mark a
    // registration "completed" - otherwise a devotee could credit themselves
    // for seva they never performed. That includes creating it already
    // completed, and "re-joining" over a completed record. The doc id is
    // always <uid>_<sevaId>, which the sevas counter rule above relies on.
    match /seva_registrations/{regId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isStaff());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        regId == request.auth.uid + '_' + request.resource.data.sevaId &&
        request.resource.data.status == 'registered';
      allow update: if isSignedIn() && (
        isStaff() ||
        (
          request.auth.uid == resource.data.userId &&
          resource.data.status != 'completed' &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.sevaId == resource.data.sevaId &&
          request.resource.data.status in ['registered', 'cancelled']
        )
      );
      allow delete: if false;
    }

    // ---------------- HOSTEL LISTINGS ----------------
    // Ongoing youth-hostel rooms/beds, managed by staff and publicly browsable
    // (same "public read" pattern as events, so a logged-out visitor can see
    // what's available before signing up).
    match /hostel_listings/{listingId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // ---------------- HOSTEL BOOKINGS ----------------
    // Mirrors accommodation_requests: a devotee can create their own booking
    // request and read it back; only staff can change its status
    // (approve/reject/waitlist), and only the status/notes fields - they can
    // never rewrite which listing or user a booking points to. No direct
    // client update is allowed on someone else's identifying fields, and a
    // devotee can never mark their own booking approved.
    match /hostel_bookings/{bookingId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isStaff());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isSignedIn() && (
        (
          isStaff() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'staffNotes', 'updatedAt'])
        ) ||
        (
          // Owner may only cancel their own still-pending request.
          request.auth.uid == resource.data.userId &&
          resource.data.status == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          request.resource.data.status == 'cancelled'
        )
      );
      allow delete: if isSuperAdmin();
    }

    // ---------------- OTP CODES (Flaxxa WhatsApp login) ----------------
    // One-time codes for phone sign-in, written/read only by the backend via
    // the Admin SDK (which bypasses these rules). A browser-readable OTP
    // would defeat the whole purpose, so every client access is denied.
    match /otp_codes/{phone} {
      allow read, write: if false;
    }

    // ---------------- FOLLOW-UPS (FOLK guide notes) ----------------
    // Private notes a guide keeps about a member. Members never see them.
    match /followups/{followupId} {
      allow read: if isStaff();
      allow create: if isStaff() &&
        request.resource.data.guideId == request.auth.uid &&
        request.resource.data.note is string &&
        request.resource.data.note.size() <= 1500;
      allow update, delete: if isSuperAdmin() || (isStaff() && resource.data.guideId == request.auth.uid);
    }

    // ---------------- COURSES ----------------
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    // A member enrols themselves (id <courseId>_<uid>, starting at zero);
    // only staff record sessions attended or completion.
    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isStaff());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        enrollmentId == request.resource.data.courseId + '_' + request.auth.uid &&
        request.resource.data.status == 'enrolled' &&
        request.resource.data.sessionsAttended == 0;
      allow update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    // ---------------- CONTACT MESSAGES ----------------
    match /contact_messages/{messageId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'new' &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 2000;
      allow read, update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    // ---------------- BROADCAST LOG (server-written) ----------------
    match /broadcasts/{broadcastId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ---------------- EVENT SECRETS ----------------
    // Self-check-in tokens, kept apart from the publicly readable events.
    // Server-only (Admin SDK); staff get the token from createEvent's reply.
    match /event_secrets/{eventId} {
      allow read, write: if false;
    }

    // ---------------- TRIPS (yatras / pilgrimages) ----------------
    // Publicly readable so the /trips list and each /trip/<slug> landing page
    // work for logged-out visitors (same pattern as events). Only staff
    // create and edit them.
    match /trips/{tripId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // ---------------- TRIP REGISTRATIONS ----------------
    // A devotee registers themselves for a trip; staff confirm/cancel and can
    // see every registration.
    //
    // NOTE ON PAYMENT STATE: the client may only ever write `paymentOrderId`,
    // a POINTER to the Razorpay order. It can never write a "paid" flag,
    // because that would be forgeable from the browser. Whether money actually
    // arrived ONLINE is resolved by reading payments/{paymentOrderId}, which
    // only the server's webhook can mark completed/verified. Never trust a
    // paid-looking field stored on the registration itself.
    //
    // CASH is the one exception, and deliberately so: there is no webhook for
    // a handful of notes across a desk, so `cashCollected` is a STAFF
    // ATTESTATION - "I received this money". That is why it sits only in the
    // staff branch below and can never be written by the devotee, who could
    // otherwise mark their own seat paid. `paymentMode` is the devotee's
    // declared intent at registration time and carries no payment meaning on
    // its own.
    // The pointer may only name an order the server created for this very
    // registration (createOrder records userId + tripRegistrationId on it),
    // never someone else's payment or an unrelated ₹1 donation.
    function isOwnOrderFor(regId) {
      let orderId = request.resource.data.paymentOrderId;
      let path = /databases/$(database)/documents/payments/$(orderId);
      return orderId is string && exists(path) &&
        get(path).data.userId == request.auth.uid &&
        get(path).data.get('tripRegistrationId', '') == regId;
    }

    match /trip_registrations/{regId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());

      // The staff-only attestation fields (and the payment pointer) can't be
      // pre-filled at creation either, or a devotee could create their seat
      // already marked "cash collected".
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.seats is int &&
        request.resource.data.seats > 0 &&
        request.resource.data.seats <= 20 &&
        request.resource.data.get('cashCollected', false) == false &&
        !request.resource.data.keys().hasAny(['cashAmount', 'cashCollectedAt', 'cashCollectedBy']) &&
        request.resource.data.get('paymentOrderId', null) == null;

      allow update: if isSignedIn() && (
        (
          // Staff move a registration through its lifecycle and record cash
          // handed over in person, and nothing else - they can never repoint
          // it at a different trip or devotee, or touch paymentOrderId.
          isStaff() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'status', 'staffNotes', 'updatedAt',
              'cashCollected', 'cashAmount', 'cashCollectedAt', 'cashCollectedBy'
            ])
        ) ||
        (
          // Owner attaches the Razorpay order id once checkout starts.
          request.auth.uid == resource.data.userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['paymentOrderId', 'updatedAt']) &&
          isOwnOrderFor(regId)
        ) ||
        (
          // Owner cancels their own still-pending seat.
          request.auth.uid == resource.data.userId &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
        )
      );

      allow delete: if isSuperAdmin();
    }

    // ---------------- PAYMENTS ----------------
    // Every payments doc is created and updated exclusively by the server
    // (createOrder + the Razorpay webhook), using the Admin SDK, which
    // bypasses these rules entirely. No client - devotee, folks_head, or
    // admin - ever needs to write here, so all client writes are denied.
    // This is what makes the webhook the single source of truth: nobody can
    // forge a "completed"/"verified" donation from the browser.
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isStaff());
      allow create, update, delete: if false;
    }
  }
}
