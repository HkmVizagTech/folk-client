# Copy to .env.local and fill in your values
# Backend API (Railway)
VITE_BACKEND_URL=https://folkvizag-backend-production.up.railway.app

# Razorpay PUBLIC key id (used by the client checkout only - never the secret).
# TEST key: rzp_test_...    LIVE key: rzp_live_...
# The matching secret + webhook secret live on the server (RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET).
VITE_RAZORPAY_KEY=rzp_test_your_key_here

# Firebase (your own project - replace with values from Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
